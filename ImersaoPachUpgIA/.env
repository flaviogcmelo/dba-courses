# =============================================================
# Oracle Imersão AutoUpgrade — Variáveis de Ambiente
# =============================================================
# INSTRUÇÕES:
#   1. Copie este arquivo para .env  (cp .env.template .env)
#   2. Preencha todos os campos CHANGE_ME
#   3. Verifique DISK_DEVICE e GOLD_IMAGE_* antes de rodar
#   4. NUNCA commite o arquivo .env
# =============================================================

# --- Conexão com a VM ---
VM_IP=192.168.0.180
VM_HOSTNAME=srv01.localdomain
SSH_KEY=~/.ssh/oracle_imersao       # Gerado pelo skill oracle-imersao

# --- Credenciais do SO (nunca em código) ---
ROOT_PWD=oraclepwd
ORACLE_OS_PWD=oraclepwd

# --- Oracle: usuário e grupos ---
ORACLE_USER=oracle
ORACLE_GROUP=oinstall
DBA_GROUP=dba

# --- Estrutura de diretórios Oracle ---
ORACLE_BASE=/u01/app/oracle
ORACLE_HOME_19C=/u01/app/oracle/product/19.3.0/db_1
ORACLE_HOME_19C_PATCHED=/u01/app/oracle/product/19.3.0/dbhome_1
ORACLE_HOME_23AI=/u01/app/oracle/product/23.0.0/dbhome_1
ORACLE_INVENTORY=/u01/app/oraInventory

# --- Banco de dados ---
ORACLE_SID=ORCL
ORACLE_PWD=oraclepwd                # Senha SYS/SYSTEM/PDBADMIN
DB_MEMORY_MB=2048
DB_REDO_SIZE_MB=200
DB_CHARSET=AL32UTF8

# --- Armazenamento ---
DISK_DEVICE=/dev/sdb               # Verificar com: lsblk  (ex: /dev/sdb)
VG_NAME=vg_u02
LV_NAME=lv_u02
MOUNT_POINT=/u02
ORADATA_DIR=/u02/oradata
FRA_DIR=/u02/fra

# --- Instalação ---
INSTALL_DIR=/install
GOLD_IMAGE_19C=LINUX.X64_193000_db_home.zip            # Ex: LINUX.X64_193000_db_home.zip
GOLD_IMAGE_23AI=LINUX.X64_2326100_db_home.zip      # Ex: LINUX.X64_2326100_db_home.zip
GOLD_IMAGE_23AI_PATCHED=p39099680_230000_Linux-x86-64.zip  # Gold Image completa 23.26.2 (apesar do nome de patch, é db_home.zip completo — extrair, nao usar opatch)
AUTOUPGRADE_JAR=/install/autoupgrade.jar

# --- AutoUpgrade ---
AUTOUPGRADE_LOG_DIR=/u01/app/oracle/cfgtoollogs/autoupgrade
PATCH_DIR=/install/patches

# --- Patches disponíveis em /install ---
OPATCH_ZIP=p6880880_190000_Linux-x86-64.zip          # OPatch atualizado para 19c
PATCH_19C_ZIP=p39034528_190000_Linux-x86-64.zip      # Release Update 19c

# --- Oracle 23ai ---
ORACLE_23AI_VERSION=23.26.1
ORACLE_23AI_PATCH_VERSION=23.26.2
